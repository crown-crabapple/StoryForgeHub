{
  "name": "@storyforge/server",
  "version": "0.1.0",
  "private": true,
  "description": "StoryForge local read-only JSON API and static file server",
  "type": "module",
  "exports": "./src/server.mjs",
  "scripts": {
    "test": "node --import ../../scripts/test-isolate-config.mjs --test \"test/*.test.mjs\"",
    "test:large": "node --import ../../scripts/test-isolate-config.mjs --test --test-concurrency=1 --test-timeout=900000 \"test/*.large.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@storyforge/ai": "0.1.0",
    "@storyforge/core": "0.1.0",
    "@storyforge/export": "0.1.0",
    "@storyforge/format": "0.1.0",
    "@storyforge/legacy-import": "0.1.0",
    "@storyforge/store": "0.1.0"
  }
}

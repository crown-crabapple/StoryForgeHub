# StoryForge container settings. Copy this file to deploy/storyforge.env (next to compose.yaml) and edit the copy; the copy is not committed.
# There are no secrets here: StoryForge has no API keys of its own and the owner's password is chosen in the browser, through the setup link.

# personal | shared. The image defaults to shared (accounts, roles, invites, audit). personal has no accounts and listens on 127.0.0.1 inside
# the container, which is only reachable from outside with network_mode: host.
STORYFORGE_MODE=shared

# The user name of the first owner (3-32 characters: a-z, 0-9, dot, underscore, hyphen). On the first start, when the shared data has no owner,
# the container creates it and prints a one-time setup link in its log (docker compose logs storyforge). Later starts print nothing more.
STORYFORGE_OWNER=owner

# The address people type in the browser, as the reverse proxy shows it. Use https:// whenever the server can be reached from other computers.
# The setup link and the cookie flags are built from it. Remove the line only for a trial on this computer.
STORYFORGE_PUBLIC_URL=https://write.example.org

# The port inside the container (compose publishes it on 127.0.0.1:4317 of the host).
STORYFORGE_PORT=4317

# The address the server listens on inside the container. 0.0.0.0 (the default in shared mode) is right for a container: compose decides which
# host address publishes it. On a bare server behind a proxy use 127.0.0.1. Personal mode refuses anything but 127.0.0.1.
# STORYFORGE_HOST=0.0.0.0

# The three folders. The image already sets these to the volumes compose mounts; change them only if you change the mounts too.
# STORYFORGE_LIBRARY=/library
# STORYFORGE_SHARED_DATA=/shared-data
# XDG_CONFIG_HOME=/config

# Settings for deploy/storyforge-db-backup.sh. Copy to /etc/storyforge/backup.env (mode 600, owner root) and edit.

# Required. The age PUBLIC key the backups are encrypted to. Make the key pair on another computer (age-keygen -o storyforge-backup.key),
# keep the private key there (and a second copy somewhere safe), and paste only the "public key: age1..." line here. Without the private
# key the backups cannot be read, by anyone, including you.
STORYFORGE_BACKUP_AGE_RECIPIENT=

# Strongly advised. Where to copy the backups off this server (an rsync target, e.g. backup@backup-host:storyforge/). The far side keeps its own
# history: nothing there is ever deleted by this script.
# STORYFORGE_BACKUP_COPY_TO=

# The defaults below match deploy/storyforge.service and a database made with `createdb -O storyforge storyforge`.
# STORYFORGE_BACKUP_DBNAME=storyforge
# STORYFORGE_BACKUP_DIR=/var/backups/storyforge
# STORYFORGE_BACKUP_CONFIG_DIR=/var/lib/storyforge/config
# STORYFORGE_BACKUP_KEEP_DAILY=7
# STORYFORGE_BACKUP_KEEP_WEEKLY=4
# STORYFORGE_BACKUP_KEEP_MONTHLY=3
